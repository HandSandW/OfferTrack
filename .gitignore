# Keep development-process documents local. Only the public user/release set is tracked.
/*.md
!/README.md
!/CHANGELOG.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
/docs/*
!/docs/agent-api.md
!/docs/backup-format.md
!/docs/user-guide/
!/docs/user-guide/README.md
.github/ISSUE_TEMPLATE/
.github/pull_request_template.md

