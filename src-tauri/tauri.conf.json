{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OfferTrack",
  "version": "0.1.0",
  "identifier": "app.offertrack.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OfferTrack",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "shortDescription": "离线优先的求职投递管理工具",
    "longDescription": "OfferTrack 将投递信息、简历和备份保存在用户选择的本地数据仓库中。"
  }
}
